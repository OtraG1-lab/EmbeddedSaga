package com.example.vehicle

interface Vehicle {
    version {
        major 1
        minor 0
    }

    attribute UInt32 speed

    method getSpeed {
        out {
            UInt32 speed
        }
    }

    method setSpeed {
        in {
            UInt32 speed
        }
    }

    method getVehicleDetails {
        out {
            UInt32 speed
            UInt32 engineRpm
            String gear
            Double outsideTemp
            UInt32 batteryLevel
        }
    }

    method setVehicleDetails {
        in {
            UInt32 speed
            UInt32 engineRpm
            String gear
            Double outsideTemp
            UInt32 batteryLevel
        }
    }

    broadcast speedChanged {
        out {
            UInt32 speed
        }
    }
}
