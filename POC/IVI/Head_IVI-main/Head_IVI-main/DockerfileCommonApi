# syntax=docker/dockerfile:1

# Legacy monolithic build kept for compatibility. The split build uses
# DockerfileCommonApi.base and DockerfileCommonApi.app.
FROM --platform=linux/amd64 debian:bookworm-slim AS generator-tools
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /opt/covesa

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates openjdk-17-jre-headless unzip wget \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q -O commonapi_core_generator.zip https://github.com/COVESA/capicxx-core-tools/releases/download/3.2.15/commonapi_core_generator.zip && \
    wget -q -O commonapi_dbus_generator.zip https://github.com/COVESA/capicxx-dbus-tools/releases/download/3.2.15/commonapi_dbus_generator.zip && \
    wget -q -O commonapi_someip_generator.zip https://github.com/COVESA/capicxx-someip-tools/releases/download/3.2.15/commonapi_someip_generator.zip && \
    unzip -q commonapi_core_generator.zip -d core-gen && unzip -q commonapi_dbus_generator.zip -d dbus-gen && unzip -q commonapi_someip_generator.zip -d someip-gen

FROM --platform=linux/arm64 debian:bookworm-slim AS runtime-builder
ENV DEBIAN_FRONTEND=noninteractive
ARG DLT_DAEMON_REF=v2.18.10
ENV DLT_PREFIX=/opt/dlt
ENV PKG_CONFIG_PATH=/opt/dlt/lib/pkgconfig:/usr/local/lib/pkgconfig
ENV LD_LIBRARY_PATH=/opt/dlt/lib:/usr/local/lib
WORKDIR /opt/covesa

RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf automake build-essential ca-certificates cmake git dbus dbus-daemon dbus-x11 \
    libboost-filesystem-dev libboost-system-dev libdbus-1-dev libexpat1-dev libglib2.0-dev libjson-c-dev \
    libgstreamer1.0-dev gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-libav \
    libtool patch pkg-config wget zlib1g-dev ninja-build \
    qt6-base-dev qt6-declarative-dev qt6-webengine-dev libqt6svg6-dev \
    qml6-module-qtqml qml6-module-qtqml-workerscript \
    qml6-module-qtquick-controls qml6-module-qtquick-templates \
    qml6-module-qtquick-layouts qml6-module-qtquick-window \
    qml6-module-qtwebengine qt6-qmltooling-plugins \
    libgl1-mesa-dev libxkbcommon-dev libxkbcommon-x11-dev \
    libgl1-mesa-dri xvfb x11-utils x11vnc novnc websockify \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "$DLT_DAEMON_REF" https://github.com/COVESA/dlt-daemon.git /tmp/dlt-daemon && \
    cmake -S /tmp/dlt-daemon -B /tmp/dlt-daemon/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$DLT_PREFIX" -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=etc && \
    cmake --build /tmp/dlt-daemon/build --parallel 2 && cmake --install /tmp/dlt-daemon/build && rm -rf /tmp/dlt-daemon

RUN git clone --depth 1 -b 3.2.4 https://github.com/COVESA/capicxx-core-runtime.git && cmake -S capicxx-core-runtime -B capicxx-core-runtime/build -DCMAKE_INSTALL_PREFIX=/usr/local -DCMAKE_PREFIX_PATH=/opt/dlt && cmake --build capicxx-core-runtime/build --target install
RUN git clone --depth 1 -b 3.6.4 https://github.com/COVESA/vsomeip.git && cmake -S vsomeip -B vsomeip/build -DCMAKE_INSTALL_PREFIX=/usr/local && cmake --build vsomeip/build --target install && ldconfig
RUN git clone --depth 1 -b 3.2.4 https://github.com/COVESA/capicxx-someip-runtime.git && cmake -S capicxx-someip-runtime -B capicxx-someip-runtime/build -DCMAKE_INSTALL_PREFIX=/usr/local -DCMAKE_PREFIX_PATH=/usr/local && cmake --build capicxx-someip-runtime/build --target install

RUN wget -q -O dbus-1.12.20.tar.gz https://dbus.freedesktop.org/releases/dbus/dbus-1.12.20.tar.gz && \
    for patch_name in capi-dbus-1-pc.patch capi-dbus-add-send-with-reply-set-notify.patch capi-dbus-add-support-for-custom-marshalling.patch capi-dbus-block-acquire-io-path-on-send.patch capi-dbus-correct-dbus-connection-block-pending-call.patch capi-dbus-send-with-reply-and-block-delete-reply-on-error.patch; do wget -q -O "$patch_name" "https://raw.githubusercontent.com/COVESA/capicxx-dbus-runtime/master/src/dbus-patches/$patch_name"; done && \
    tar -xf dbus-1.12.20.tar.gz && cd dbus-1.12.20 && \
    for patch_file in ../capi-dbus-*.patch; do patch --batch --forward -p1 < "$patch_file" || true; done && \
    ./configure --prefix=/usr/local --disable-doxygen-docs --disable-xml-docs --disable-tests --disable-systemd --disable-x11-autolaunch --disable-user-session && make -j2 && make install && ldconfig
RUN git clone --depth 1 -b 3.2.3-r1 https://github.com/COVESA/capicxx-dbus-runtime.git && PKG_CONFIG_PATH=/opt/dlt/lib/pkgconfig:/usr/local/lib/pkgconfig cmake -S capicxx-dbus-runtime -B capicxx-dbus-runtime/build -DCMAKE_INSTALL_PREFIX=/usr/local -DCMAKE_PREFIX_PATH="/opt/dlt;/usr/local" && cmake --build capicxx-dbus-runtime/build --target install && ldconfig

FROM generator-tools AS source-generator
WORKDIR /workspace
COPY . .
RUN mkdir -p src-gen && CORE_GENERATOR="$(find /opt/covesa/core-gen -type f -o -type l | grep -E '/commonapi-core-generator-linux-x86_64$' | head -n 1)" && DBUS_GENERATOR="$(find /opt/covesa/dbus-gen -type f -o -type l | grep -E '/commonapi-dbus-generator-linux-x86_64$' | head -n 1)" && SOMEIP_GENERATOR="$(find /opt/covesa/someip-gen -type f -o -type l | grep -E '/commonapi-someip-generator-linux-x86_64$' | head -n 1)" && test -n "$CORE_GENERATOR" && test -n "$DBUS_GENERATOR" && test -n "$SOMEIP_GENERATOR" && chmod +x "$CORE_GENERATOR" "$DBUS_GENERATOR" "$SOMEIP_GENERATOR" && "$CORE_GENERATOR" -sk -d ./src-gen ./dbus-service/dbus_interface.fidl && "$DBUS_GENERATOR" -d ./src-gen ./dbus-service/dbus_interface.fdepl && "$CORE_GENERATOR" -sk -d ./src-gen ./dbus-service/vehiclefunctions.fidl && "$DBUS_GENERATOR" -d ./src-gen ./dbus-service/vehiclefunctions.fdepl && "$CORE_GENERATOR" -sk -d ./src-gen ./dbus-service/media.fidl && "$DBUS_GENERATOR" -d ./src-gen ./dbus-service/media.fdepl && "$CORE_GENERATOR" -sk -d ./src-gen ./someip-service/someip_interface.fidl && "$SOMEIP_GENERATOR" -d ./src-gen ./someip-service/someip_interface.fdepl

FROM runtime-builder AS application-compiler
WORKDIR /workspace
COPY . .
COPY --from=source-generator /workspace/src-gen ./src-gen
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --parallel 2 && cmake -S IVI-main -B ivi-build -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build ivi-build --parallel 2

FROM runtime-builder AS runtime-delivery
ENV DEBIAN_FRONTEND=noninteractive
ENV DLT_PREFIX=/opt/dlt
ENV PKG_CONFIG_PATH=/opt/dlt/lib/pkgconfig:/usr/local/lib/pkgconfig
ENV LD_LIBRARY_PATH=/opt/dlt/lib:/usr/local/lib:/usr/lib/aarch64-linux-gnu:/lib/aarch64-linux-gnu
ENV QTWEBENGINE_CHROMIUM_FLAGS="--no-sandbox --disable-gpu-sandbox --ignore-gpu-blocklist --use-gl=swiftshader"
ENV QTWEBENGINE_DISABLE_SANDBOX=1
COPY --from=application-compiler /workspace/build/DbusServerApp /usr/local/bin/DbusServerApp
COPY --from=application-compiler /workspace/build/SomeipServerApp /usr/local/bin/SomeipServerApp
COPY --from=application-compiler /workspace/build/VehicleServerApp /usr/local/bin/VehicleServerApp
COPY --from=application-compiler /workspace/build/VehicleClientApp /usr/local/bin/VehicleClientApp.bin
COPY --from=application-compiler /workspace/build/MediaServerApp /usr/local/bin/MediaServerApp
COPY --from=application-compiler /workspace/build/MediaClientApp /usr/local/bin/MediaClientApp.bin
COPY --from=application-compiler /workspace/ivi-build/headunit_ivi /usr/local/bin/headunit_ivi
COPY commonapi.ini /etc/commonapi.ini
COPY vsomeip.json /etc/vsomeip.json
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
COPY vehicle-client-entrypoint.sh /usr/local/bin/VehicleClientApp
COPY media-client-entrypoint.sh /usr/local/bin/MediaClientApp
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/VehicleClientApp /usr/local/bin/MediaClientApp
EXPOSE 8080 3490
VOLUME ["/media"]
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["sh", "-c", "mkdir -p /tmp/runtime-root; chmod 700 /tmp/runtime-root; export XDG_RUNTIME_DIR=/tmp/runtime-root; /usr/local/bin/DbusServerApp & /usr/local/bin/SomeipServerApp & /usr/local/bin/VehicleServerApp & /usr/local/bin/MediaServerApp & Xvfb :99 -screen 0 1024x600x24 & export DISPLAY=:99; until xdpyinfo -display \"$DISPLAY\" >/dev/null 2>&1; do sleep 0.1; done; x11vnc -display :99 -nopw -forever -bg; websockify --web /usr/share/novnc/ 8080 localhost:5900 & exec /usr/local/bin/headunit_ivi"]
